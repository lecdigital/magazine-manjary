// ============================================================================
// MANJARY (மஞ்சரி) - PRISMA SCHEMA
// Configured for Hostinger MySQL Production (`u252507508_manjarydb`)
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id            String         @id @default(cuid())
  name          String
  email         String         @unique
  passwordHash  String
  role          String         @default("SUBSCRIBER") // "ADMIN" | "SUBSCRIBER"
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  subscriptions Subscription[]
}

model SubscriptionPlan {
  id              String         @id @default(cuid())
  nameTa          String
  nameEn          String
  descriptionTa   String         @db.Text
  descriptionEn   String         @db.Text
  perksTa         String         @db.Text
  perksEn         String         @db.Text
  amount          Int            // Stored in minor units (cents, e.g. 999 = $9.99)
  currency        String         @default("usd")
  billingInterval String         @default("month") // "month" | "year"
  stripeProductId String
  stripePriceId   String
  isActive        Boolean        @default(true)
  sortOrder       Int            @default(1)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  subscriptions   Subscription[]
}

model Subscription {
  id                   String           @id @default(cuid())
  userId               String
  planId               String
  stripeCustomerId     String
  stripeSubscriptionId String           @unique
  status               String           @default("active") // "active" | "canceled" | "past_due"
  currentPeriodEnd     DateTime
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  user User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Restrict)
}

model Post {
  id                 String    @id @default(cuid())
  title              String
  slug               String    @unique
  excerpt            String    @db.Text
  content            String    @db.LongText
  category           String    @default("SHORT_STORY") // "SHORT_STORY" | "NOVEL_CHAPTER" | "ARTICLE"
  bookTitle          String    @default("")
  chapterNumber      Int       @default(1)
  authorName         String    @default("எம். தயாளன் (M. Thayalan)")
  language           String    @default("ta") // "ta" | "en"
  readingTimeMinutes Int       @default(6)
  isFeatured         Boolean   @default(false)
  isPublished        Boolean   @default(true)
  publishedAt        DateTime? @default(now())
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

model MagazineIssue {
  id            String   @id @default(cuid())
  issueNumber   Int      @unique
  month         String
  year          Int
  title         String
  subtitle      String   @db.Text
  description   String   @db.Text
  highlights    String   @db.Text
  coverImageUrl String   @db.Text
  pdfUrl        String   @db.Text
  isPublished   Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}
