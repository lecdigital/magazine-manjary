# ============================================================================
# MANJARY (மஞ்சரி) - ENVIRONMENT CONFIGURATION
# ============================================================================

# --- PHASE 1: LOCAL SQLITE DEVELOPMENT ---
DATABASE_URL="file:./dev.db"

# --- PHASE 3: HOSTINGER MYSQL PRODUCTION (Uncomment when deploying to Hostinger) ---
# 1. Change provider = "mysql" in prisma/schema.prisma
# 2. Replace DATABASE_URL below with your Hostinger MySQL credentials:
# DATABASE_URL="mysql://u123456789_manjary:YOUR_DB_PASSWORD@127.0.0.1:3306/u123456789_manjary_db"

# --- NEXTAUTH CONFIGURATION ---
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="manjary-local-dev-secret-change-in-production-9f8e7d6c5b4a"

# --- STRIPE DYNAMIC PRICING & CHECKOUT ---
# Leave as placeholder for local simulated Stripe sync & checkout,
# or paste your real sk_test_... / sk_live_... keys to connect directly to Stripe.
STRIPE_SECRET_KEY="sk_test_placeholder_local_mode"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_placeholder_local_mode"
STRIPE_WEBHOOK_SECRET="whsec_placeholder_local_mode"

# --- PUBLIC APP URL ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"

