/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# Next.js
/.next/
/out/

# Production
/build

# Local SQLite Databases (Never commit local DBs)
*.db
*.db-journal
*.sqlite
*.sqlite3
prisma/*.db
prisma/*.db-journal

# Environment Variables (Never commit secrets)
.env
.env*.local
.env.development
.env.production

# Keep .env.example tracked
!.env.example

# Misc / OS
.DS_Store
*.pem
Thumbs.db

# Debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Vercel
.vercel

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Uploaded files
/public/uploads/issues/*
!/public/uploads/issues/.gitkeep


